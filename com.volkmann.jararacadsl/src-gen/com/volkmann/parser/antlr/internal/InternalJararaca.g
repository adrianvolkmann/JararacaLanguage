RULE_FLOAT : ('0'..'9')+ '.' ('0'..'9')+;

RULE_SL_COMMENT : '//' ~(('\n'|'\r'))* ('\n'|'\r')?;

RULE_ML_COMMENT : '/*' ( options {greedy=false;} : . )*'*/';


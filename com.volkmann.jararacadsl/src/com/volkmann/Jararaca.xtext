grammar com.volkmann.Jararaca with org.eclipse.xtext.common.Terminals hidden(WS, ML_COMMENT, SL_COMMENT)

generate jararaca "http://www.volkmann.com/Jararaca"

import "http://www.eclipse.org/emf/2002/Ecore" as ecore

Program:
	'program' '{'
		statements+=Statement*
	'}';

Statement:
	VariableDeclaration | Assignment | IfStatement | WhileStatement | DoWhileStatement;

Block:
	'{' statements+=Statement* '}';

IfStatement:
	'if' '(' condition=Expression ')' block=Block
	('else' elsePart=ElsePart)?;

ElsePart:
	IfStatement | Block;

WhileStatement:
	'while' '(' condition=Expression ')' block=Block;

DoWhileStatement:
	'do' block=Block 'while' '(' condition=Expression ')' ';';

VariableDeclaration:
	'var' name=ID type=Type ('=' initialValue=Expression)? ';';

Assignment:
	name=ID '=' value=Expression ';';

Type:
	IntType | FloatType | BooleanType | StringType;

IntType:
	{IntType} 'int';

FloatType:
	{FloatType} 'decimal';

BooleanType:
	{BooleanType} 'boolean';

StringType:
	{StringType} 'string';

Expression:
	OrExpression;

OrExpression returns Expression:
	AndExpression ({OrExpression.left=current} 'or' right=AndExpression)*;

AndExpression returns Expression:
	Comparison ({AndExpression.left=current} 'and' right=Comparison)*;

Comparison returns Expression:
	Addition ({Comparison.left=current} operator=('==' | '!=' | '<=' | '>=' | '<' | '>') right=Addition)*;

Addition returns Expression:
	Multiplication ({Addition.left=current} operator=('+' | '-') right=Multiplication)*;

Multiplication returns Expression:
	Unary ({Multiplication.left=current} operator=('*' | '/' | '%') right=Unary)*;

Unary returns Expression:
	{NotExpression} 'not' operand=Unary
	| {Negative} '-' operand=Unary
	| Primary;

Primary returns Expression:
	{ParenExpression} '(' inner=Expression ')'
	| IntLiteral
	| FloatLiteral
	| BooleanLiteral
	| StringLiteral
	| VariableReference;

IntLiteral:
	value=INT;

FloatLiteral:
	value=FLOAT;

BooleanLiteral:
	TrueLiteral | FalseLiteral;

TrueLiteral:
	{TrueLiteral} 'true';

FalseLiteral:
	{FalseLiteral} 'false';

StringLiteral:
	value=STRING;

VariableReference:
	name=ID;

terminal FLOAT returns ecore::EDouble:
	('0'..'9')+ '.' ('0'..'9')+;

terminal SL_COMMENT:
	'//' !('\n' | '\r')* ('\n' | '\r')?;

terminal ML_COMMENT:
	'/*' -> '*/';
